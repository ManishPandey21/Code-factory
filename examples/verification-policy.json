      "kind": "unit",
      "argv": [
        "python",
        "/ABS/infra-code-factory/test_report.py",
        "--report",
        "{report}",
        "--junit",
        ".factory-test-output/frontend-unit.xml",
        "--mode",
        "{test_mode}",
        "--",
        "/ABS/trusted-project-ci/run-suite",
        "frontend-unit",
        ".factory-test-output/frontend-unit.xml"
      ],
      "report": "frontend-unit.json",
      "min_tests": 1,
      "negative_control": {
        "argv": [
          "python",
          "/ABS/trusted-project-ci/inject-defect.py",
          "frontend-unit",
          "{worktree}"
        ],
        "expected_failures": [
          "[\"REPLACE_SUITE\",\"REPLACE_CLASS\",\"REPLACE_TEST\"]"
        ]
